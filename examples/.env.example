# GoRoute AI Gateway - Environment Keys Template
# Rename this file to .env or export these variables in your shell.
# All demos run 100% offline with zero-config mocks if these variables are empty.

# OpenAI API Key (Tested with openai/gpt-4o-mini)
OPENAI_API_KEY=

# Anthropic Claude API Key (Tested with anthropic/claude-haiku-4-5-20251001)
ANTHROPIC_API_KEY=

# Google Gemini API Key (Tested with gemini/gemini-2.5-flash-lite)
GEMINI_API_KEY=
